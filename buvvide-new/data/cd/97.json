); padding: 3px; font-size: 14px;\">8 m</td>\r\n        </tr>\r\n    </tbody>\r\n</table>\r\n<p><font color=\"#000000\"> </font></p>\r\n<p>&nbsp;</p>\r\n<p>&nbsp;</p>","Valcprofils  (griešana uz pasūtījumu)":"<p style=\"font-family: Calibri, Tahoma, Arial, sans-serif; font-size: medium;\">Valcprofils ir viens no senākajiem metāla jumtu veidiem, kas joprojām ir labākais risinājums sarežģītu konstrukciju jumtiem. &Scaron;ī jumta materiāla iegāde ir ilgtermiņa ieguldījums, ņemot vērā tā izturību. Valcrofils ar dubulto malas ieloku atbilsto&scaron;i jumta konstrukcijai ir iespējams izvēlēties valcprofilu ar gludu virsmu, kā arī ar divām stingrības ribām.</p>\r\n<table class=\"s-table\" style=\"font-family: Calibri, Tahoma, Arial, sans-serif; color: rgb(0, 0, 0);\" width=\"100%\">\r\n    <tbody>\r\n        <tr>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(250, 250, 250); padding: 3px; font-size: 14px;\">Loksnes gabarītplatums</td>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(250, 250, 250); padding: 3px; font-size: 14px;\">545 mm</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(238, 238, 238); padding: 3px; font-size: 14px;\">Sedzo&scaron;ais platums</td>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(238, 238, 238); padding: 3px; font-size: 14px;\">545 mm</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(250, 250, 250); padding: 3px; font-size: 14px;\">Materiāla biezums</td>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(250, 250, 250); padding: 3px; font-size: 14px;\">0.45-0.6 mm</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(238, 238, 238); padding: 3px; font-size: 14px;\">Profila augstums</td>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(238, 238, 238); padding: 3px; font-size: 14px;\">25 mm</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(250, 250, 250); padding: 3px; font-size: 14px;\">Izejmateriāla veidi</td>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(250, 250, 250); padding: 3px; font-size: 14px;\">Zn, PE, PE matt, PURMATT</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(238, 238, 238); padding: 3px; font-size: 14px;\">Maksimālais garums</td>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(238, 238, 238); padding: 3px; font-size: 14px;\">9 m</td>\r\n        </tr>\r\n    </tbody>\r\n</table>","Glūda loksne":"<p><img height=\"115\" alt=\"\" width=\"175\" align=\"left\" src=\"/userfiles/Image/aprkat_bild/bilde2(3).gif\" /></p>\r\n<p>&nbsp;</p>\r\n<p>Platums 1.25 m<br />\r\nBiezums 0.5 mm</p>","Trapecveida PP-45 profili  (griešana uz pasūtījumu)":"<p>&nbsp;<span style=\"font-family: Calibri, Tahoma, Arial, sans-serif; font-size: medium;\">Trapecveida profilu PP45 iespējams pasūtīt ar antikondensāta slāni, ar kura palīdzību kondensāts caur ventilācijas kanāliem tiek izvadīts ārpus ēkas.</span></p>\r\n<p>&nbsp;</p>\r\n<table class=\"s-table\" style=\"font-family: Calibri, Tahoma, Arial, sans-serif; color: rgb(0, 0, 0);\">\r\n    <tbody>\r\n        <tr>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(250, 250, 250); padding: 3px; font-size: 14px;\">Loksnes gabarītplatums</td>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(250, 250, 250); padding: 3px; font-size: 14px;\">1060&plusmn;1% mm</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(238, 238, 238); padding: 3px; font-size: 14px;\">Sedzo&scaron;ais platums</td>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(238, 238, 238); padding: 3px; font-size: 14px;\">1020&plusmn;1% mm</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(250, 250, 250); padding: 3px; font-size: 14px;\">Materiāla biezums</td>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(250, 250, 250); padding: 3px; font-size: 14px;\">0.45-0.7 mm</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(238, 238, 238); padding: 3px; font-size: 14px;\">Profila augstums</td>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(238, 238, 238); padding: 3px; font-size: 14px;\">44&plusmn;1 m</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(250, 250, 250); padding: 3px; font-size: 14px;\">Izejmateriāla veidi</td>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(250, 250, 250); padding: 3px; font-size: 14px;\">Zn, PE, PE matt, PURMATT</td>\r\n        </tr>\r\n        <tr>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(238, 238, 238); padding: 3px; font-size: 14px;\">Maksimālais garums</td>\r\n            <td style=\"font-family: Calibri, Tahoma, Arial, sans-serif; background: rgb(238, 238, 238); padding: 3px; font-size: 14px;\">10 m</td>\r\n        </tr>\r\n    </tbody>\r\n</table>","Valcprofils NORDIK un NORDIK WAVE ar KLIK sistēmu":"<p>&nbsp;Valcprofils NORDIK un NORDIK WAVE ar KLIK sistēmu un nolocītu priek&scaron;ējo profila malu ir valcēta metāla jumta modernā versi